{
  "name": "fastify-init",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11.4.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format:check": "prettier --check .",
    "format": "pg_format migrations/* --inplace && prettier --write .",
    "lint:check": "eslint .",
    "lint": "eslint . --fix",
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json && cp package.prod.json dist/package.json",
    "dev": "node --conditions=development --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "NODE_PATH=dist NODE_ENV=production node dist/src/index.js",
    "db:migrate:create": "pgroll create",
    "db:migrate:up": "dotenv pgroll up && pnpm db:orm:gen",
    "db:migrate:down": "dotenv pgroll down && pnpm db:orm:gen",
    "db:orm:gen": "rm -rf ./src/storage/drizzle && drizzle-kit pull && node scripts/fix-drizzle-output.ts"
  },
  "imports": {
    "#/*.js": {
      "development": "./src/*.ts",
      "default": "./src/*.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/eslint-plugin": "^1.6.18",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@sinclair/typebox": "^0.34.49",
    "@fastify/type-provider-typebox": "^6.1.0",
    "drizzle-orm": "1.0.0-beta.22",
    "env-schema": "^7.0.0",
    "fastify": "^5.8.5",
    "hyperid": "^4.0.0",
    "pgroll": "^0.0.9",
    "pino": "^10.3.1",
    "postgres": "^3.4.9"
  }
}
